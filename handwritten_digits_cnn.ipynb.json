      "Testing labels: (10000,)\n"
     ]
    }
   ],
   "source": [
    "# mnist.load_data() downloads the dataset the first time (then reuses the saved copy).\n",
    "# It returns two pairs: (training images, training labels) and (test images, test labels).\n",
    "(X_train, Y_train), (X_test, Y_test) = mnist.load_data()\n",
    "\n",
    "# .shape tells us the dimensions of an array.\n",
    "print(\"Training images:\", X_train.shape)   # (60000, 28, 28) -> 60,000 images of 28 x 28 pixels\n",
    "print(\"Training labels:\", Y_train.shape)   # (60000,)        -> one label per image\n",
    "\n",
    "print(\"Testing images:\", X_test.shape)     # (10000, 28, 28)\n",
    "print(\"Testing labels:\", Y_test.shape)     # (10000,)"
   ]
